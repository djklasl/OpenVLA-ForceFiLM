; ============================================
; 问题定义：定义任务场景的基本信息
; ============================================
(define (problem LIBERO_Floor_Manipulation)  ; 定义问题名称：地面操作任务
  (:domain robosuite)                        ; 仿真域：使用 robosuite
  (:language Pick the milk and place it in the basket)  ; 任务描述（人类可读）

; ============================================
; 区域定义：定义场景中各个空间的范围
; 格式：(区域名 (:target 目标表面) (:ranges (x_min x_max y_min y_max)))
; ============================================
    (:regions
      ; -------- 篮子放置区域 --------
      (bin_region                                    ; 区域名称：篮子放置区
          (:target floor)                           ; 放置目标：地板上
          (:ranges (                                ; 坐标范围 (x_min x_max y_min y_max)
              (-0.01 0.25 0.01 0.27)                ; 篮子在这个矩形范围内
            )
          )
      )

      ; -------- 目标物体区域（牛奶初始位置） --------
      (target_object_region                         ; 区域名称：目标物体区域（**牛奶放这里**）
          (:target floor)                           ; 放置目标：地板上
          (:ranges (                                ; 坐标范围
              (-0.145 -0.265 -0.095 -0.215)        ; 牛奶在这个位置（**要抓取的目标**）
            )
          )
      )

      ; -------- 其他物体区域（障碍物位置） --------
      (other_object_region_0                        ; 其他物体区域0：**奶油奶酪**
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.075 -0.075)          ; 奶油奶酪的坐标范围
            )
          )
      )

      (other_object_region_1                        ; 其他物体区域1：**番茄酱**
          (:target floor)
          (:ranges (
              (-0.175 0.035 -0.125 0.085)           ; 番茄酱的坐标范围
            )
          )
      )

      (other_object_region_2                        ; 其他物体区域2：**黄油**
          (:target floor)
          (:ranges (
              (0.075 -0.225 0.125 -0.175)          ; 黄油的坐标范围
            )
          )
      )

      (other_object_region_3                        ; 其他物体区域3：**橙汁**
          (:target floor)
          (:ranges (
              (0.125 0.005 0.175 0.055)            ; 橙汁的坐标范围
            )
          )
      )

      (other_object_region_4                        ; 其他物体区域4：**巧克力布丁**
          (:target floor)
          (:ranges (
              (-0.225 -0.105 -0.175 -0.055)        ; 巧克力布丁的坐标范围
            )
          )
      )

      ; -------- 容纳区域（篮子内部，用于判断任务完成） --------
      (contain_region                               ; 区域名称：容纳区域
          (:target basket_1)                        ; 目标：篮子1的内部（**任务完成的判断依据**）
      )
    )

; ============================================
; 固定装置：场景中不动的物体
; ============================================
  (:fixtures
    floor - floor                                   ; 地板（名称=地板，类型=地板）
  )

; ============================================
; 物体定义：场景中所有可交互的物体
; 格式：(物体名称 - 物体类型)
; ============================================
  (:objects
    milk_1 - milk                                  ; milk_1：牛奶（**目标物体，要抓取的**）
    basket_1 - basket                              ; basket_1：篮子（**目标容器，要放入的**）
    cream_cheese_1 - cream_cheese                  ; 奶油奶酪（障碍物）
    tomato_sauce_1 - tomato_sauce                  ; 番茄酱（障碍物）
    butter_1 - butter                              ; 黄油（障碍物）
    orange_juice_1 - orange_juice                  ; 橙汁（障碍物）
    chocolate_pudding_1 - chocolate_pudding        ; 巧克力布丁（障碍物）
  )

; ============================================
; 关注对象：任务中需要操作的物体
; ============================================
  (:obj_of_interest
    milk_1                                         ; 要被移动的物体
    basket_1                                       ; 目标容器
  )

; ============================================
; 初始状态：任务开始时各物体的位置
; 格式：(谓词 物体名称 所在区域)
; ============================================
  (:init
    (On milk_1 floor_target_object_region)         ; 牛奶在目标物体区域（**初始位置**）
    (On cream_cheese_1 floor_other_object_region_0) ; 奶酪在区域0
    (On tomato_sauce_1 floor_other_object_region_1) ; 番茄酱在区域1
    (On butter_1 floor_other_object_region_2)       ; 黄油在区域2
    (On orange_juice_1 floor_other_object_region_3) ; 橙汁在区域3
    (On chocolate_pudding_1 floor_other_object_region_4) ; 布丁在区域4
    (On basket_1 floor_bin_region)                  ; 篮子在篮子区域
  )

; ============================================
; 任务目标：完成任务需要满足的条件
; ============================================
  (:goal
    (And (In milk_1 basket_1_contain_region))      ; 条件：牛奶在篮子内部（**任务完成标志**）
  )

)

; ============================================
; 格式说明总结
; ============================================
; 区域定义格式：
;   (区域名 (:target 目标表面) (:ranges (x_min x_max y_min y_max)))
;   坐标范围：x_min x_max y_min y_max (单位：米)
;
; 物体定义格式：
;   (物体名 - 物体类型)
;
; 初始状态格式：
;   (On 物体 所在区域)
;
; 目标状态格式：
;   (And (条件1) (条件2) ...)
;   (In 物体 容器区域)
;
; 注释符号：分号 ;
; ============================================
